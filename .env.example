# Credentials for the Urja Meter Ops portal (READ-ONLY account).
# Copy this file to .env and fill in real values. Never commit .env.
URJA_USER=operator@urja.local
URJA_PASSWORD=changeme

# Portal base URL (defaults to the production portal if unset)
URJA_PORTAL_BASE_URL=https://urja-ops.flockenergy.tech

# Outbound request timeouts, seconds
URJA_TIMEOUT_SECONDS=15.0
URJA_LOGIN_TIMEOUT_SECONDS=15.0

# How many times to retry a failed outbound GET before giving up
URJA_MAX_RETRIES=2
