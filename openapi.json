{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops REST API",
    "description": "Read-only REST wrapper around the legacy \"Urja Meter Ops\" portal.\n\nEvery response mirrors the portal's own field names (see PROTOCOL.md for the\nverified protocol) and adds a `warnings` array where portal data was messy.\n\nAll upstream failures are mapped: 404 (unknown meter), 502 (portal failed),\n504 (portal timeout). Credentials and stack traces are never exposed.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/dashboard": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Interactive Web Client Dashboard",
        "description": "Serve the modern single-page dashboard with Leaflet map and Chart.js.",
        "operationId": "dashboard_dashboard_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness probe (no portal call)",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
