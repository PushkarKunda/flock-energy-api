  "components": {
    "schemas": {
      "ConsumptionResponse": {
        "properties": {
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            },
            "type": "array",
            "title": "Data"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "ConsumptionResponse",
        "description": "Energy history for a meter over the portal's window.\n\n`timezone` is explicit: the portal timestamps carry NO timezone info and we\ncould not verify one, so it stays null (documented in PROTOCOL.md)."
      },
      "EnergyReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kwh"
          },
          "kvah": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kvah"
          },
          "voltR": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltr"
          }
        },
        "type": "object",
        "required": [
          "timestamp"
        ],
        "title": "EnergyReading",
        "description": "One 30-minute reading. Portal sends everything as strings."
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "GeoPoint": {
        "properties": {
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          }
        },
        "type": "object",
        "title": "GeoPoint",
        "description": "Portal /geo sends lat/long as strings; client.py converts to float."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HierarchyCircle": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "divisions": {
            "items": {
              "$ref": "#/components/schemas/HierarchyDivision"
            },
            "type": "array",
            "title": "Divisions"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "HierarchyCircle"
      },
      "HierarchyDT": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "capacityKva": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capacitykva"
          },
          "metersCount": {
            "type": "integer",
            "title": "Meterscount",
            "default": 0
          },
          "meters": {
            "items": {
              "$ref": "#/components/schemas/HierarchyMeter"
            },
            "type": "array",
            "title": "Meters"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "HierarchyDT"
      },
      "HierarchyDivision": {
